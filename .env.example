# Supabase Configuration
# Get these from your Supabase project: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ_YOUR_ANON_KEY_HERE
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Note: The Supabase service_role key is NEVER used client-side.
# It's only used in Edge Functions (set via Supabase dashboard secrets).
# Edge Function secrets (set in Supabase dashboard, NOT in .env):
#   RESEND_API_KEY=re_YOUR_RESEND_KEY  (for sending emails via create-client function)
